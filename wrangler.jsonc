{
  // Cron every 3 hours UTC: 00:00, 03:00, 06:00, …, 21:00 (8 runs/day).
  "name": "job-maxxing",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 */3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job-maxxing",
      "database_id": "8ce02da8-fb5f-4edd-b81e-b42f5547eb8e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_BASE_URL": "https://YOUR_SUBDOMAIN.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
