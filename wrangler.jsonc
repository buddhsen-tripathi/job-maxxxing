{
  // Bot is paused indefinitely (AI cost / digest overflow). Cron is empty on
  // purpose so a deploy cannot restart polling. Restore "*/15 * * * *" to resume.
  "name": "job-maxxing",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job-maxxing",
      "database_id": "8ce02da8-fb5f-4edd-b81e-b42f5547eb8e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RESUMES",
      "bucket_name": "job-maxxing-resumes"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // Set APP_BASE_URL outside git (Dashboard vars or `wrangler secret put APP_BASE_URL`).
    "BOARD_INGEST_BATCH_SIZE": "16",
    "BOARD_PRIORITY_CAP": "6"
  },
  "observability": {
    "enabled": true
  }
}
